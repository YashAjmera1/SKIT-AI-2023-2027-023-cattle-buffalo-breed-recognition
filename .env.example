# Indian Cattle & Buffalo Breed Recognition System
# Project ID: SKIT/AI/2023-2027/023

# Backend Database Configuration
DATABASE_URL=sqlite:///./breed_recognition.db
# For PostgreSQL: postgresql://username:password@localhost:5432/livestock_db

# Storage & Upload Limits
MAX_UPLOAD_MB=10

# Machine Learning Models
MODEL_PATH=models/breed_classifier.joblib
